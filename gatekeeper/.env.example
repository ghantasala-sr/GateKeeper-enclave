# Copy to .env and replace the values. Never commit .env.

# Postgres container (read by docker-compose.yml)
POSTGRES_USER=gatekeeper_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gatekeeper
POSTGRES_PORT=5434

# Owner: ONLY for migrations, seeding, and ingestion. Bypasses row-level security.
MIGRATION_DATABASE_URL=postgresql://gatekeeper_owner:change-me@localhost:5434/gatekeeper
# Limited role used by the running app (created by migrations/003_app_role.sql).
APP_DB_PASSWORD=change-me-too
APP_DATABASE_URL=postgresql://gatekeeper_app:change-me-too@localhost:5434/gatekeeper

# Chat model: vertex-gemini (the Enclave) or anthropic (local development)
LLM_PROVIDER=anthropic

# Gemini on Vertex AI. No key: authenticates with ADC (gcloud auth application-default login, or Workload Identity on GKE)
VERTEX_PROJECT=
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Anthropic API (local development only)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CHAT_MODEL=claude-opus-5-5

# Okta OIDC (Acme). Issuer is your authorization server, e.g. https://dev-123.okta.com/oauth2/default
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=your-client-id
OKTA_CLIENT_SECRET=your-client-secret
OKTA_REDIRECT_URI=http://localhost:8000/auth/okta/callback

# Signs the short-lived login session cookie. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Signs Gatekeeper access tokens (RS256). Generate with: cd backend && python -m scripts.gen_signing_key
TOKEN_SIGNING_KEY_B64=change-me
TOKEN_ISSUER=http://localhost:8000

# Keycloak (Globex SAML IdP). Admin console: http://localhost:8080
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8080
# Password for the 3 Globex test users, set by scripts.setup_keycloak
GLOBEX_TEST_PASSWORD=change-me

# Globex SAML login (Keycloak locally; for real Entra use its App Federation Metadata Url and Entra Identifier)
SAML_IDP_METADATA_URL=http://localhost:8080/realms/globex/protocol/saml/descriptor
SAML_IDP_ENTITY_ID=http://localhost:8080/realms/globex

# Where the login callbacks send the browser when the login started from the frontend
FRONTEND_URL=http://localhost:3000
